{
  "name": "jgr-importaciones",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute jgr-db --local --file=./db/schema.sql && wrangler d1 execute jgr-db --local --file=./db/seed.sql",
    "db:init:remote": "wrangler d1 execute jgr-db --remote --file=./db/schema.sql && wrangler d1 execute jgr-db --remote --file=./db/seed.sql",
    "deploy": "wrangler deploy",
    "deploy:shop": "wrangler deploy --env shop",
    "dev:shop": "wrangler dev --env shop --port 8788",
    "db:migrar:shop": "wrangler d1 execute jgr-db --remote --file=./db/migraciones/0001-shop.sql",
    "test": "vitest run tests/unit.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integracion": "vitest run tests/integration.test.ts",
    "seed": "node scripts/build-seed.mjs",
    "db:schema:remote": "wrangler d1 execute jgr-db --remote --file=./db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=20"
  }
}
