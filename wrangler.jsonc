{
	// Configuración de Cloudflare Workers para JGR Importaciones.
	// Reemplaza los valores marcados con REEMPLAZAR siguiendo el README.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tienda",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "none"
	},
	"d1_databases": [
    {
      "binding": "DB",
      "database_name": "jgr-db",
      "database_id": "48676e34-3728-417f-b9ae-24b1f1238a33"
    }
  ],
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "jgr-imagenes"
		}
	],
	"vars": {
		// Repositorio de GitHub cuyos colaboradores (con permiso de escritura) pueden entrar a /admin.
		"GITHUB_REPO": "Fervelop/jgr-importaciones",
		// Client ID de tu GitHub OAuth App (no es secreto).
		"GITHUB_CLIENT_ID": "Ov23lizhAUBnM4CsTFvR",
		// "read:user" si el repositorio es público; "repo" si es privado (GitHub lo exige para ver tus permisos).
		"GITHUB_SCOPE": "read:user"
	},
	"env": {
		// Tienda 2: mismos productos, fotos y textos de JGR (misma base de datos y mismas fotos),
		// con sus propios precios, su propio WhatsApp, sus propios pedidos y un panel limitado.
		// Se publica con: npx wrangler deploy --env shop  (o npm run deploy:shop)
		// Dirección: https://shop.jgrimportaciones.workers.dev
		"shop": {
			"name": "shop",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "jgr-db",
					"database_id": "48676e34-3728-417f-b9ae-24b1f1238a33"
				}
			],
			"r2_buckets": [
				{
					"binding": "IMAGES",
					"bucket_name": "jgr-imagenes"
				}
			],
			"vars": {
				// Identificador de esta tienda en la base de datos. No lo cambies después de poner precios.
				"STORE": "t2",
				// Únicos usuarios de GitHub que entran a /admin de la tienda 2 (los colaboradores del repositorio NO entran).
				"ADMIN_USERS": "Fervelop",
				"GITHUB_REPO": "Fervelop/jgr-importaciones",
				// Client ID de la SEGUNDA GitHub OAuth App (la de la tienda 2). Ver README.
				"GITHUB_CLIENT_ID": "Ov23lixTgvLZ6cwjUGM3",
				"GITHUB_SCOPE": "read:user"
			}
		}
	}
}